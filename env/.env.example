# LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_API_MODE=native
STRUCTURED_OUTPUT_MODE=native

# User Principal Configuration
