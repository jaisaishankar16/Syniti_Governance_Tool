# ==============================================================================
# MDM Syniti — Environment Configuration Template
# ==============================================================================

# AI Gateway / LLM Provider Configuration
# Base URL for AI Gateway (e.g. https://gateway.company.com/v1 or custom OpenAI endpoint).
# The URL is used verbatim as configured without modifying path segments.
OPENAI_BASE_URL=https://your-gateway-host

# API Key for authentication with AI Gateway or LLM provider (treated as secret).
OPENAI_API_KEY=your-key-here

# Target model identifier hosted on your AI gateway (e.g. gpt-4o-mini, gpt-6-luna).
LLM_MODEL=your-model-name

# API connection mode: 'chat_completions' (default for gateway) or 'responses'.
LLM_API_MODE=chat_completions

# Model temperature (default: 0.1 for high determinism).
LLM_TEMPERATURE=0.1

# Maximum reasoning/tool turns before aborting analysis.
LLM_MAX_TURNS=6

# LLM call timeout in seconds.
LLM_TIMEOUT_S=60.0

# Structured output mode: 'auto' (detects capabilities), 'native', or 'json_prompt'.
STRUCTURED_OUTPUT_MODE=auto

# Tool execution mode: 'auto' (detects tool support), 'native', or 'prefetch'.
TOOLS_MODE=auto

# Optional path to corporate CA bundle file for internal TLS verification.
LLM_CA_BUNDLE=

# Optional JSON-formatted string of extra HTTP headers for gateway routing/auth.
LLM_EXTRA_HEADERS=

# User Principal Configuration
# Optional administrative API key for cache purges and learned knowledge approval.
ADMIN_API_KEY=your-admin-key-here

# Placeholder principal name displayed in UI navigation.
PLACEHOLDER_PRINCIPAL_NAME="Jai Shankar"

# Placeholder principal email for authentication display.
PLACEHOLDER_PRINCIPAL_EMAIL="jai.shankar@example.com"

# Application Deployment Settings
# Deployment environment: 'development' or 'production'.
APP_ENV=development

# Host interface binding for the FastAPI ASGI server.
HOST=127.0.0.1

# TCP port for the backend server.
PORT=8000

# Rate limit backend: 'memory' for single node or 'redis' for clusters.
RATE_LIMIT_BACKEND=memory

# Cache backend: 'memory' for single node or 'redis' for clusters.
CACHE_BACKEND=memory

# Daily token consumption limit enforced across all requests.
DAILY_TOKEN_BUDGET=10000000

# Directory path where activity execution timelines are persisted.
ACTIVITY_DATA_DIR=data
