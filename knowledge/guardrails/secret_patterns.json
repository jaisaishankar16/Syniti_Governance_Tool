{
  "schema_version": "1.0.0",
  "name": "secret_patterns",
  "description": "Regex patterns for detecting sensitive credentials, API keys, private keys, and tokens",
  "patterns": [
    {
      "id": "SEC-OPENAI-01",
      "name": "OpenAI API Key",
      "regex": "\\bsk-[A-Za-z0-9_-]{20,}\\b",
      "severity": "critical"
    },
    {
      "id": "SEC-AWS-01",
      "name": "AWS Access Key",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "severity": "critical"
    },
    {
      "id": "SEC-PRIVKEY-01",
      "name": "Private Key Block",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "severity": "critical"
    },
    {
      "id": "SEC-CONN-PWD-01",
      "name": "Connection Password",
      "regex": "(?i)(?:password|pwd)\\s*=\\s*['\"]?([^'\"\\s;]{4,})['\"]?",
      "severity": "high"
    },
    {
      "id": "SEC-BEARER-01",
      "name": "Bearer Token",
      "regex": "(?i)\\bbearer\\s+[A-Za-z0-9_\\-\\.~+/]+=*",
      "severity": "high"
    },
    {
      "id": "SEC-JWT-01",
      "name": "JSON Web Token",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
      "severity": "high"
    },
    {
      "id": "SEC-GENERIC-ENTROPY-01",
      "name": "High-Entropy Secret Keyword",
      "regex": "(?i)(?:api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token)\\s*[:=]\\s*['\"]?([A-Za-z0-9_\\-]{16,})['\"]?",
      "severity": "high"
    }
  ]
}

